{
    "_comment": "Конфигурация обучения DQN. Параметры эксперимента B4 (исправленная формула target + eval-фаза).",
    "_version": "B4",

    "seed": 42,

    "episodes": 2000,
    "max_steps": 1500,
    "eval_every": 25,
    "eval_max_steps": 1500,
    "print_every": 50,

    "lr": 0.001,
    "gamma": 0.99,

    "epsilon_start": 1.0,
    "epsilon_min": 0.01,
    "epsilon_decay": 0.998,

    "memory_size": 30000,
    "batch_size": 128,
    "target_update": 500,

    "use_huber": true,
    "grad_clip": 1.0
}
